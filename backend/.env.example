# ---------------------------------------------------------------------------
# Musical Impact Smart TV - backend environment
# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit .env - it is gitignored.
# On Render these are set in the dashboard, and render.yaml generates the
# secret ones automatically on first deploy.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local:  postgres://user:password@localhost:5432/smarttv
# Render: injected automatically from the database in render.yaml
# Leave BLANK to run without a database. The TV still works: sessions, sync,
# presence and games all live in memory. Only favorites, history and saved
# settings need Postgres, and they degrade to per-viewer local storage.
DATABASE_URL=

# Postgres schema every table lives in. Lets this project share a database with
# something else without colliding: table names like `users` and `settings` are
# generic enough that another app on the same database may well want them too,
# and a named schema means both can have one.
# Connections are pinned to it with NO `public` fallback, so a missing schema
# fails loudly instead of quietly polluting whatever else is in there.
DB_SCHEMA=smarttv

# Port the API listens on. Render sets this for you.
PORT=3000

# Public url of the frontend static site. Used for CORS.
# Render injects the host name; a bare host name is fine, https is assumed.
FRONTEND_URL=http://localhost:5173

# Extra allowed origins, comma separated. Usually empty.
EXTRA_CORS_ORIGINS=

# Signs the short-lived tokens the HUD carries in its MOAP url.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret between the LSL scripts and this backend. The object signs
# every request with it, and this backend signs everything it pushes back to
# the object. Put the SAME value in the TV config notecard in world.
LSL_SHARED_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 to allow unsigned requests from Second Life. Development only -
# it disables the check that requests really came from your object.
ALLOW_UNSIGNED_LSL=0
